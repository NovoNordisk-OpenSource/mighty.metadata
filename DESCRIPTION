Package: mighty.metadata
Title: Manage 'CDISC' 'ADaM' Dataset Specifications in 'YAML' Format
Version: 0.1.1
Authors@R: c(
    person("Aksel", "Thomsen", , "oath@novonordisk.com", role = c("aut", "cre")),
